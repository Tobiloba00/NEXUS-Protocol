# Copy to .env.local for local dev. In production these live in Vercel's
# env var settings (Project Settings -> Environment Variables), never committed.

# Public site URL — used for absolute metadata/OG URLs and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (free tier project) — service-role key is SERVER-ONLY, see
# lib/supabase/server.ts. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the GitHub Actions poller workflow sends as a bearer token
# to POST /api/internal/poll. Generate any long random string; set the same
# value here and as the POLL_SECRET repo secret in GitHub Actions.
POLL_SECRET=

# Telegram bot (create via @BotFather) — used by the webhook route and the
# poller's alert-delivery step.
TELEGRAM_BOT_TOKEN=
# Set to any long random string, then run lib/telegram/bot.ts's
# webhookSetupInstructions() curl command once to register it with Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Public (no @ prefix) — used client-side to build the t.me deep link on /alerts.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
